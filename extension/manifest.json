{
  "manifest_version": 3,
  "name": "PolyMod for PolyTrack",
  "version": "1.1.0",
  "description": "Injects the PolyMod overlay (camera, cheats, HUD, replays, leaderboard tools) into the unmodified PolyTrack web game, on any site you allow.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PolyMod sites",
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://app-polytrack.kodub.com/*"],
      "js": ["src/compat.js", "src/gameapi.js", "src/api-base.js", "src/mod.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
